{
  "name": "@celeste-next-gym/collector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MessagePack HTTP facade for the Celeste/Everest data collector",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "e2e:real": "tsx ../../scripts/e2e-real/run.ts",
    "e2e:timeline-regressions": "tsx ../../scripts/e2e-real/run.ts --timeline-regressions",
    "test:e2e-harness": "tsx --test ../../scripts/e2e-real/test/**/*.test.ts ../../scripts/e2e-real/scenarios/**/*.test.ts",
    "test:timeline-regressions": "tsx --test ../../scripts/e2e-real/test/timeline-regressions.test.ts",
    "typecheck:e2e-harness": "tsc -p ../../scripts/e2e-real/tsconfig.json",
    "test:e2e-recording": "tsx --test ../../scripts/e2e-real/recording/**/*.test.ts",
    "typecheck:e2e-recording": "tsc -p ../../scripts/e2e-real/recording/tsconfig.json"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.15",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}

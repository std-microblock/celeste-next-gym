{
  "version": 2,
  "id": "training-map-4",
  "title": "反向 Hyper",
  "summary": "一张可实时测试的训练地图。",
  "modules": [
    {
      "id": "lesson-1",
      "trigger": {
        "id": "lesson-1-start",
        "bounds": {
          "x": 0,
          "y": 104,
          "width": 56,
          "height": 76
        }
      },
      "end_trigger": {
        "id": "lesson-1-end",
        "bounds": {
          "x": 56,
          "y": 0,
          "width": 24,
          "height": 180
        }
      },
      "tutorial": {
        "version": 2,
        "id": "lesson-1-tutorial",
        "title": "教程 1",
        "summary": "依次完成 冲刺、跳跃。",
        "entry": {
          "input_id": "dash",
          "hint": "按 冲刺 开始。",
          "check": [
            "!current.dead"
          ],
          "failure": {
            "title": "需要 冲刺",
            "body": "先按 冲刺。"
          }
        },
        "teaching": {
          "steps": [
            {
              "prompt": "按 冲刺。",
              "order_error": {
                "title": "动作顺序不正确",
                "body": "按 冲刺。"
              },
              "window_error": {
                "title": "错过输入窗口",
                "body": "稍早或稍晚按 冲刺。"
              }
            },
            {
              "prompt": "按 跳跃并保持 10 帧；X 速度 325 px/s，剩余冲刺。",
              "order_error": {
                "title": "动作顺序不正确",
                "body": "按 跳跃。"
              },
              "window_error": {
                "title": "错过输入窗口",
                "body": "稍早或稍晚按 跳跃。"
              }
            }
          ]
        },
        "assist": {
          "result_sample_after_input_frames": 0,
          "auto_slowdown": {
            "enabled_by_default": true,
            "radius_frames": 12,
            "minimum_multiplier": 0.85
          }
        },
        "fuzz": {
          "version": 1,
          "inputs": [
            {
              "id": "hold-down-left",
              "keys": [
                "down",
                "left"
              ],
              "at": 0,
              "held_time": "direction_change_1",
              "verify": false
            },
            {
              "id": "hold-right",
              "keys": [
                "right"
              ],
              "at": "jump_frame",
              "held_time": "hold::inf",
              "verify": true
            },
            {
              "id": "dash",
              "keys": [
                "dash"
              ],
              "at": 0,
              "verify": true
            },
            {
              "id": "jump",
              "keys": [
                "jump"
              ],
              "at": "jump_frame",
              "verify": true,
              "held_time": 10
            }
          ],
          "variables": [
            {
              "name": "direction_change_1",
              "range": {
                "from": 1,
                "to": 8
              }
            },
            {
              "name": "jump_frame",
              "range": {
                "from": 9,
                "to": 16
              }
            }
          ],
          "observe_until": "max(20, jump_frame + 10)",
          "success": [],
          "objectives": [],
          "search": {
            "bindings": {},
            "output": [
              "best",
              "windows",
              "coverage"
            ]
          },
          "checkpoints": [
            {
              "id": "recorded-node-10",
              "at": "jump_frame",
              "description": "X 速度 325 px/s，剩余冲刺",
              "success": [
                "after.speed.x >= 324.99",
                "after.speed.x <= 325.01"
              ],
              "objectives": [
                {
                  "type": "maximize",
                  "expression": "after.speed.x"
                },
                {
                  "type": "maximize",
                  "expression": "after.dashes"
                }
              ]
            }
          ]
        }
      },
      "validation": {
        "initial_state": {
          "pos": {
            "x": 5,
            "y": 151
          },
          "speed": {
            "x": 0,
            "y": 0
          },
          "state": "Normal",
          "facing": true,
          "dashes": 1,
          "stamina": 110,
          "on_ground": false,
          "ducking": false,
          "can_dream_dash": true,
          "dead": false,
          "death_freeze_pending": false,
          "respawn_frames": 0,
          "dash_dir": {
            "x": 0,
            "y": 0
          }
        }
      }
    }
  ],
  "finish": {
    "trigger": {
      "id": "training-map-4-room-finish",
      "bounds": {
        "x": 224,
        "y": 0,
        "width": 96,
        "height": 180
      }
    },
    "require_all_modules": true
  }
}
